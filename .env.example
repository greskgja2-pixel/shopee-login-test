# Preencha estes valores na Vercel (Project Settings > Environment Variables)
# ou num arquivo .env.local para rodar localmente.

# Partner ID e Partner Key do seu app criado no Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# URL de callback exatamente igual à cadastrada no painel do Shopee Open Platform
# Ex: https://seu-app.vercel.app/api/shopee/callback
SHOPEE_REDIRECT_URL=

# "test" para o ambiente sandbox (test-stable) ou "live" para produção
SHOPEE_ENV=test
